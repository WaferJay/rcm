# Required: API key that MCP clients must present as `Authorization: Bearer <key>`
RCM_API_KEY=

# Required: public base URL clients use to reach this server.
# Used to build absolute stdout/stderr download URLs returned to the agent.
RCM_PUBLIC_BASE_URL=https://rcm.example.com

# Optional: path to YAML config (default: ./commands.yaml)
RCM_CONFIG=./commands.yaml

# Optional: bind address/port (defaults: 0.0.0.0 / 8000)
RCM_HOST=0.0.0.0
RCM_PORT=8000

# Optional: directory where run logs are stored (default: ./runs)
RCM_RUNS_DIR=./runs

# Optional: how many runs to keep on disk; older ones are pruned at startup.
# 0 or unset = keep everything.
RCM_RUNS_RETENTION=0
